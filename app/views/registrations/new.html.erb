<% content_for :title, t(".title") %>

<div class="card narrow auth-card">
  <h1><%= t(".title") %></h1>
  <p class="muted"><%= t(".subtitle", count: User::MINIMUM_PASSWORD_LENGTH) %></p>

  <%= form_with model: @user, url: registration_path, class: "stack" do |form| %>
    <%= render "shared/errors", record: @user %>

    <div class="field">
      <%= form.label :email_address %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
            minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit t(".submit"), class: "button button-block" %>
  <% end %>

  <p class="auth-links"><%= link_to t(".sign_in"), new_session_path %></p>
</div>

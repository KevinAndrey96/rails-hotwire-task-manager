<% content_for :title, t(".title") %>

<div class="page-header">
  <h1><%= t(".title") %></h1>
  <%= link_to t(".new"), new_project_path, class: "button" %>
</div>

<% if @projects.present? %>
  <ul class="project-grid">
    <% @projects.each do |project| %>
      <li class="card project-card">
        <h2><%= link_to project.name, project %></h2>
        <% if project.description.present? %>
          <p class="muted"><%= truncate(project.description, length: 120) %></p>
        <% end %>
        <progress value="<%= project.tasks_done %>" max="<%= [ project.tasks_total, 1 ].max %>"></progress>
        <p class="meta"><%= t(".progress", done: project.tasks_done, total: project.tasks_total) %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card empty-state">
    <h2><%= t(".empty_title") %></h2>
    <p class="muted"><%= t(".empty_body") %></p>
    <%= link_to t(".new"), new_project_path, class: "button" %>
  </div>
<% end %>
